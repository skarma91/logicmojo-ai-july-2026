# Copy to .env at the repository root and fill in. Never commit .env.
PROVIDER=groq                 # groq | ollama | gemini
MODEL_NAME=                   # optional; blank uses the provider default
GROQ_API_KEY=
GEMINI_API_KEY=
# Wikimedia asks automated clients to identify themselves:
WIKI_USER_AGENT=my-travel-planner/1.0 (your-contact)
