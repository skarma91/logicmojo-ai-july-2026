# .env is gitignored; never commit real keys.
# Which provider to call: gemini | groq | ollama (default: ollama)

PROVIDER=

# Optional. Leave blank to use the per-provider default:
# gemini -> gemini-3.5-flash-lite
# groq -> openai/gpt-oss-20b
# ollama -> llama3.2

MODEL_NAME=

# API keys. Needed only for the cloud providers you actually use.
# ollama runs locally and needs no key.

GEMINI_API_KEY=
GROQ_API_KEY=